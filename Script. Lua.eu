-- ================================================================
-- VALIDATION / CONFIG / RECOVERY
-- ================================================================

local function sanitizeState()
    State.FOVRadius = clamp(State.FOVRadius, 25, 500)
    State.RenderDistance = clamp(State.RenderDistance, 50, 1500)
    State.AimSmooth = clamp(State.AimSmooth, 1, 20)
    State.HitboxX = clamp(State.HitboxX, 1, 10)
    State.HitboxY = clamp(State.HitboxY, 1, 10)
    State.HitboxZ = clamp(State.HitboxZ, 1, 10)
    State.InfoTextSize = clamp(State.InfoTextSize, 10, 18)
    State.SnaplineThickness = clamp(State.SnaplineThickness, 1, 5)
    State.FOVLineThickness = clamp(State.FOVLineThickness, 1, 5)
    State.MinBoxPixels = clamp(State.MinBoxPixels, 2, 20)
    State.FallbackGroupId = math.max(0, math.floor(tonumber(State.FallbackGroupId) or 0))
    State.ValidationInterval = clamp(State.ValidationInterval, 1, 10)
    State.ESPUpdateRate = clamp(State.ESPUpdateRate, 10, 60)

    if State.AimMode ~= "Off"
        and State.AimMode ~= "Aimbot"
        and State.AimMode ~= "Silent Aim (Trident)" then
        State.AimMode = "Off"
    end

    if State.TeamFilter ~= "All"
        and State.TeamFilter ~= "Enemies Only"
        and State.TeamFilter ~= "Teammates Only" then
        State.TeamFilter = "Enemies Only"
    end

    if State.TeamColorMode ~= "Auto"
        and State.TeamColorMode ~= "Relationship"
        and State.TeamColorMode ~= "Custom" then
        State.TeamColorMode = "Auto"
    end
end

local function updateLegacyTeammateState()
    State.Teammates = State.TeamFilter == "All"
end

local function validateUIHandles()
    local checks = {
        { "Window", Window },
        { "Combat Tab", Combat },
        { "Visual Tab", Visual },
        { "Misc Tab", Misc },
        { "Settings Tab", Settings },
        { "FOV", FOVCircle },
        { "FOV line", FOVTargetLine },
        { "Overlay", Overlay },
        { "QuickBar", QuickBar },
    }

    local missing = {}

    for _, item in ipairs(checks) do
        if item[2] == nil then
            table.insert(missing, item[1])
        end
    end

    return #missing == 0, missing
end

local function validateRuntime()
    sanitizeState()

    local failures = {}
    local camera = getCamera()

    if not LocalPlayer then
        table.insert(failures, "LocalPlayer")
    end

    if not getGuiParent() then
        table.insert(failures, "PlayerGui/CoreGui")
    end

    if not camera then
        table.insert(failures, "CurrentCamera")
    end

    if type(RunService.BindToRenderStep) ~= "function" then
        table.insert(failures, "RunService.BindToRenderStep")
    end

    local uiOk, missingUI = validateUIHandles()
    if not uiOk then
        for _, item in ipairs(missingUI) do
            table.insert(failures, item)
        end
    end

    if State.RuntimeProfile == "Trident" and game.PlaceId ~= TRIDENT_PLACE_ID then
        table.insert(failures, "Trident PlaceId mismatch")
    end

    if State.RuntimeProfile == "Auto" and game.PlaceId == TRIDENT_PLACE_ID then
        -- Auto selects the Trident adapter only for this known PlaceId.
        -- The universal visual/target layer remains available regardless.
    elseif State.RuntimeProfile == "Auto" then
        -- Universal profile is the fallback outside the known PlaceId.
    end

    if #failures > 0 then
        State.SystemEnabled = false
        Initialized = false
        pushRuntimeLog("CHECK", "Falha de disponibilidade: " .. table.concat(failures, ", "))
        return false, failures
    end

    pushRuntimeLog(
        "CHECK",
        string.format(
            "Runtime OK | profile=%s | platform=%s | place=%s",
            State.RuntimeProfile,
            getPlatformName(),
            tostring(game.PlaceId)
        )
    )

    return true, {}
end

local function setSystemEnabled(value, reason)
    if value then
        local ok = validateRuntime()
        if not ok then
            State.SystemEnabled = false
            Initialized = false
            notify("OverSeek", "Inicialização bloqueada: ambiente indisponível.")
            return false
        end

        State.SystemEnabled = true
        Initialized = true
        pushRuntimeLog("READY", reason or "Sistema inicializado.")
        notify("OverSeek", "Sistema inicializado com validação concluída.")
        updateResolverExport()
        return true
    end

    State.SystemEnabled = false
    Initialized = false
    pushRuntimeLog("SAFE", reason or "Sistema colocado em standby.")
    updateResolverExport()
    return true
end

local function manualSaveConfiguration()
    sanitizeState()

    local ok, result = safeCall("Save configuration", function()
        return Window:Save()
    end)

    if ok and result ~= false then
        pushRuntimeLog("CONFIG", "Configuração salva manualmente.")
        notify("Configuration", "Configuração salva manualmente.")
        return true
    end

    notify("Configuration Error", "Falha ao salvar a configuração.")
    return false
end

local function manualLoadConfiguration()
    local ok, result = safeCall("Load configuration", function()
        return Window:Load()
    end)

    if ok and result ~= false then
        sanitizeState()
        updateLegacyTeammateState()
        pushRuntimeLog("CONFIG", "Configuração carregada manualmente.")
        notify("Configuration", "Configuração carregada.")
        return true
    end

    notify("Configuration Error", "Falha ao carregar a configuração.")
    return false
end

local function resetFeatureStates()
    State.AimMode = "Off"
    State.AimEnabled = false
    State.ESPEnabled = false
    State.Snapline = false
    State.FOVCircle = false
    State.FOVTargetLine = false
    State.FOVTargetDot = false
    State.HitboxVisualizer = false

    safeCall("Reset UI", function()
        if UI.AimMode then UI.AimMode:Set("Off") end
        if UI.AimEnabled then UI.AimEnabled:Set(false) end
        if UI.ESPEnabled then UI.ESPEnabled:Set(false) end
        if UI.Snapline then UI.Snapline:Set(false) end
        if UI.FOVCircle then UI.FOVCircle:Set(false) end
        if UI.FOVTargetLine then UI.FOVTargetLine:Set(false) end
        if UI.FOVTargetDot then UI.FOVTargetDot:Set(false) end
        if UI.HitboxVisualizer then UI.HitboxVisualizer:Set(false) end
    end)

    pushRuntimeLog("RESET", "Funções visuais colocadas em OFF.")
end

local function reinitializeSystem()
    if RecoveryInProgress then
        return false
    end

    RecoveryInProgress = true
    pushRuntimeLog("INIT", "Reinicialização solicitada.")
    clearRuntimeObjects()

    local ok = validateRuntime()
    if not ok then
        RecoveryInProgress = false
        return false
    end

    State.SystemEnabled = true
    Initialized = true
    RecoveryInProgress = false
    pushRuntimeLog("READY", "Reinicialização concluída.")
    updateResolverExport()
    notify("OverSeek", "Reinicialização concluída sem reter objetos antigos.")
    return true
end

