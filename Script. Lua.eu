-- ================================================================
-- DEVELOPER TAB / LOCAL KEY GATE
-- ================================================================

Developer = Window:CreateTab({
    name = "Developer",
    icon = "code",
})

local DEV_KEY = "nexosover" -- UI gate only; this is not cryptographic secrecy.

Developer:CreateSection({
    name = "Restricted",
})

UI.DevStatus = Developer:CreateText({
    name = "Developer Status",
    text = "LOCKED · chave necessária.",
})

UI.DevKeyInput = Developer:CreateInput({
    name = "Developer Key",
    description = "Chave local para liberar informações de diagnóstico do desenvolvedor; não é gravada na configuração.",
    placeholderText = "Digite a chave",
    callback = function(value)
        State.DevUnlocked = tostring(value) == DEV_KEY

        if State.DevUnlocked then
            UI.DevStatus:Set("UNLOCKED · diagnóstico disponível.")
            pushRuntimeLog("DEV", "Developer panel desbloqueado.")
            updateResolverExport()
        else
            UI.DevStatus:Set("LOCKED · chave inválida.")
            State.ExportResolver = false
            updateResolverExport()
        end
    end,
})

UI.ExportResolver = Developer:CreateToggle({
    name = "Export Resolver",
    description = "Somente para desenvolvimento: expõe o resolver em RuntimeEnv. Desligado por padrão.",
    value = false,
    flag = "ExportResolver",
    callback = function(value)
        State.ExportResolver = State.DevUnlocked and value or false
        updateResolverExport()
    end,
})

Developer:CreateButton({
    name = "Refresh Developer Info",
    description = "Atualiza a caixa de informações do runtime atual.",
    callback = function()
        if not State.DevUnlocked then
            notify("Developer", "Painel bloqueado.")
            return
        end

        local jobId = tostring(game.JobId or "-")
        local count = #Players:GetPlayers()
        local maxPlayers = game:GetService("Players").MaxPlayers
        local memoryText = "n/a"

        safeCall("Memory stats", function()
            local stats = game:GetService("Stats")
            if stats and stats.GetTotalMemoryUsageMb then
                memoryText = string.format("%.1f MB", stats:GetTotalMemoryUsageMb())
            end
        end)

        UI.DevServerInfo:Set(string.format(
            "PlaceId: %s\nJobId: %s\nPlayers: %d/%d\nPlatform: %s\nFPS: %d\nMemory: %s\nUptime: %ds",
            tostring(game.PlaceId),
            jobId,
            count,
            maxPlayers,
            getPlatformName(),
            CurrentFPS,
            memoryText,
            round(runtimeUptime())
        ))
    end,
})

UI.DevServerInfo = Developer:CreateText({
    name = "Server Info",
    text = "LOCKED",
})

Developer:CreateButton({
    name = "Lock Developer Panel",
    description = "Remove a autorização local e apaga a exportação do resolver.",
    callback = function()
        State.DevUnlocked = false
        State.ExportResolver = false
        updateResolverExport()
        UI.DevStatus:Set("LOCKED · painel bloqueado.")
        UI.DevServerInfo:Set("LOCKED")
        pushRuntimeLog("DEV", "Developer panel bloqueado.")
    end,
})

-- ================================================================
-- PLAYER / CAMERA LIFECYCLE
-- ================================================================

connect(
    Players.PlayerRemoving,
    function(player)
        removeESP(player)
        removeHitboxVisualizer(player)
        RelationshipCache[player] = nil
    end,
    "PlayerRemoving"
)

connect(
    Workspace:GetPropertyChangedSignal("CurrentCamera"),
    function()
        Camera = Workspace.CurrentCamera or Camera
        updateFOV()
        updateFOVTargetIndicator()
    end,
    "CurrentCameraChanged"
)

-- ================================================================
-- RENDER LOOP / WATCHDOG
-- ================================================================

unbindRenderLoop()

RunService:BindToRenderStep(
    SCRIPT_RENDER_NAME,
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if not Running then
            return
        end

        if State.ErrorGuard then
            safeCall("Render Loop", function()
                Camera = Workspace.CurrentCamera or Camera

                -- FPS
                FPSAccumulator += deltaTime
                FPSFrames += 1

                if FPSAccumulator >= 0.5 then
                    CurrentFPS = round(FPSFrames / math.max(FPSAccumulator, 0.001))
                    FPSAccumulator = 0
                    FPSFrames = 0

                    StatusText.Text = string.format(
                        "  OverSeek.wtf | %d FPS",
                        CurrentFPS
                    )

                    if RuntimeStatusText then
                        RuntimeStatusText.Text = string.format(
                            "OverSeek.wtf | %d FPS | %s | ERR %d",
                            CurrentFPS,
                            State.SystemEnabled and "READY" or "STANDBY",
                            RuntimeErrorCount
                        )
                    end

                    if RuntimeStatusParagraph then
                        RuntimeStatusParagraph:Set(
                            string.format(
                                "%s | FPS %d | Errors %d | %s",
                                State.SystemEnabled and "READY" or "STANDBY",
                                CurrentFPS,
                                RuntimeErrorCount,
                                Initialized and "initialized" or "standby"
                            )
                        )
                    end
                end

                -- FOV is purely visual and is not gated by AimEnabled.
                updateFOV()

                if State.SystemEnabled then
                    updateFOVTargetIndicator()
                    updateAimbot(deltaTime)

                    ESPAccumulator += deltaTime
                    local espInterval = 1 / math.max(State.ESPUpdateRate, 10)

                    if ESPAccumulator >= espInterval then
                        ESPAccumulator = 0
                        updateESP()

                        NPCAccumulator += espInterval
                        if NPCAccumulator >= 0.10 then
                            NPCAccumulator = 0
                            updateScientistESP()
                        end

                        updateHitboxVisualizers()
                    end

                    if State.AimEnabled and State.AimMode ~= "Off" then
                        local target = getClosestTarget()

                        if target then
                            TargetStatus.Text = string.format(
                                "%s: %s | %dm | FOV %d",
                                State.AimMode == "Aimbot" and "AIM" or "TARGET",
                                target.player.Name,
                                round(target.worldDistance),
                                round(target.screenDistance)
                            )
                            TargetStatus.Visible = true
                        else
                            TargetStatus.Text = "TARGET: NONE"
                            TargetStatus.Visible = true
                        end
                    else
                        TargetStatus.Text = ""
                        TargetStatus.Visible = false
                    end
                else
                    TargetStatus.Text = ""
                    TargetStatus.Visible = false
                    FOVTargetLine.Visible = false
                    FOVTargetDot.Visible = false
                end

                if RuntimeDiagnosticsText then
                    RuntimeDiagnosticsText.Text = string.format(
                        "Errors: %d | Last: %s",
                        RuntimeErrorCount,
                        LastRuntimeError
                    )
                end

                if RuntimeStatusText then
                    RuntimeStatusText.Text = string.format(
                        "OverSeek.wtf | %d FPS | %s | ERR %d",
                        CurrentFPS,
                        State.SystemEnabled and "READY" or "STANDBY",
                        RuntimeErrorCount
                    )
                end
            end)
        else
            -- Even with ErrorGuard disabled, keep a tiny heartbeat alive without
            -- allowing a visual update exception to unwind the RenderStep callback.
            safeCall("Render Fallback", function()
                Camera = Workspace.CurrentCamera or Camera
                updateFOV()
            end)
        end

        -- Watchdog / automatic validation.
        ValidationAccumulator += deltaTime

        if State.AutoValidation and ValidationAccumulator >= State.ValidationInterval then
            ValidationAccumulator = 0

            safeCall("Watchdog", function()
                local ok = validateRuntime()

                if not ok and State.SystemEnabled and State.AutoRecovery then
                    setSystemEnabled(false, "Watchdog desativou após falha de disponibilidade.")
                end
            end)
        end
    end
)

-- ================================================================
-- INITIAL STATE / BOOT DIAGNOSTIC
-- ================================================================

updateFOV()
setDiagnosticsVisible(State.DiagnosticsOverlay)
sanitizeState()

local supported, adapterMessage = checkTridentAdapter()

safeCall("Adapter startup UI", function()
    UI.AdapterStatus:SetTitle(
        supported
            and "Adapter Status · READY"
            or "Adapter Status · CHECK"
    )
    UI.AdapterStatus:Set(adapterMessage)
end)

pushRuntimeLog(
    "BOOT",
    string.format(
        "Interface criada | PlaceId=%s | Adapter=%s",
        tostring(game.PlaceId),
        supported and "ready" or "check"
    )
)

startRelationshipWorker()

notify(
    "OverSeek.wtf",
    "Interface carregada. Clique em Initialize System para liberar os loops. Nenhuma configuração é salva automaticamente."
)

-- Runtime export remains protected until the developer gate is unlocked.
updateResolverExport()

-- ================================================================
-- CLEANUP (IDEMPOTENT)
-- ================================================================

local function cleanup()
    if not Running then
        return
    end

    Running = false
    State.SystemEnabled = false
    Initialized = false
    table.clear(RelationshipCache)

    pcall(function()
        if RelationshipWorker and task.cancel then
            task.cancel(RelationshipWorker)
            RelationshipWorker = nil
        end
    end)

    pushRuntimeLog("CLEANUP", "Iniciando limpeza do runtime.")
    clearRuntimeObjects()

    destroyInstance(Overlay)
    destroyInstance(QuickBarGui)
    destroyInstance(AdornmentFolder)

    pcall(function()
        RuntimeEnv.OverSeek_GetTarget = nil
    end)

    RuntimeEnv.OverSeek_Cleanup = nil
end

RuntimeEnv.OverSeek_Cleanup = cleanup

