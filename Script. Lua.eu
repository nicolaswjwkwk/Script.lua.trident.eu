        UI.FOVCircle:Set(State.FOVCircle)
    end,
})

Misc:CreateKeybind({
    name = "Toggle ESP",
    description = "Padrão: F5.",
    value = Enum.KeyCode.F5,
    flag = "ToggleESP",
    callback = function()
        State.ESPEnabled = not State.ESPEnabled
        UI.ESPEnabled:Set(State.ESPEnabled)
    end,
})

Misc:CreateButton({
    name = "Reset Visuals",
    description = "Desliga ESP, Snapline, FOV e hitbox visualizer.",
    callback = function()
        State.ESPEnabled = false
        State.Snapline = false
        State.FOVCircle = false
        State.HitboxVisualizer = false

        UI.ESPEnabled:Set(false)
        UI.Snapline:Set(false)
        UI.FOVCircle:Set(false)
        UI.HitboxVisualizer:Set(false)
    end,
})

-- ================================================================
-- SETTINGS TAB
-- ================================================================

local Settings = Window:CreateTab({
    name = "Settings",
    icon = "settings",
})

Settings:CreateSection({
    name = "Configuration",
})

Settings:CreateButton({
    name = "Save Configuration",
    description = "Salva a configuração atual do Rayfield.",
    callback = function()
        local ok = Window:Save()

        notify(
            ok and "Configuration" or "Configuration Error",
            ok and "Configuração salva." or "Falha ao salvar."
        )
    end,
})

Settings:CreateButton({
    name = "Load Configuration",
    description = "Carrega a configuração salva.",
    callback = function()
        local ok = Window:Load()

        notify(
            ok and "Configuration" or "Configuration Error",
            ok and "Configuração carregada." or "Falha ao carregar."
        )
    end,
})

Settings:CreateButton({
    name = "Hide UI",
    description = "Esconde a janela sem desligar as funções.",
    callback = function()
        Window:Hide()
    end,
})

-- ================================================================
-- PLAYER / CAMERA LIFECYCLE
-- ================================================================

connect(
    Players.PlayerRemoving,
    function(player)
        removeESP(player)
        removeHitboxVisualizer(player)
    end
)

connect(
    Workspace:GetPropertyChangedSignal("CurrentCamera"),
    function()
        Camera = Workspace.CurrentCamera or Camera
        updateFOV()
    end
)

-- ================================================================
-- RENDER LOOP
-- ================================================================

pcall(function()
    RunService:UnbindFromRenderStep(SCRIPT_RENDER_NAME)
end)

RunService:BindToRenderStep(
    SCRIPT_RENDER_NAME,
    Enum.RenderPriority.Camera.Value + 1,
    function(deltaTime)
        if not Running then
            return
        end

        Camera = Workspace.CurrentCamera or Camera

        -- FPS
        FPSAccumulator += deltaTime
        FPSFrames += 1

        if FPSAccumulator >= 0.5 then
            CurrentFPS = round(
                FPSFrames / FPSAccumulator
            )

            FPSAccumulator = 0
            FPSFrames = 0

            StatusText.Text = string.format(
                "  OverSeek.wtf | %d FPS",
                CurrentFPS
            )
        end

        -- Core visuals
        updateFOV()
        updateAimbot(deltaTime)

        -- ESP update at ~30 FPS to reduce UI churn.
        ESPAccumulator += deltaTime

        if ESPAccumulator >= (1 / 30) then
            ESPAccumulator = 0

            updateESP()

            NPCAccumulator += 1 / 30

            if NPCAccumulator >= 0.10 then
                NPCAccumulator = 0
                updateScientistESP()
            end

            updateHitboxVisualizers()
        end

        -- Target state
        if State.AimEnabled and State.AimMode ~= "Off" then
            local target = getClosestTarget()

            if target then
                TargetStatus.Text = string.format(
                    "%s: %s | %dm | FOV %d",
                    State.AimMode == "Aimbot"
                        and "AIM"
                        or "TARGET",
                    target.player.Name,
                    round(target.worldDistance),
                    round(target.screenDistance)
                )

                TargetStatus.Visible = true
            else
                TargetStatus.Text = "TARGET: NONE"
                TargetStatus.Visible = true
            end
        else
            TargetStatus.Text = ""
            TargetStatus.Visible = false
        end

        -- Quick buttons
        setQuickState(
            QuickButtons.AIM,
            State.AimEnabled
            and State.AimMode == "Aimbot"
        )

        setQuickState(
            QuickButtons.ESP,
            State.ESPEnabled
        )

        setQuickState(
            QuickButtons.FOV,
            State.FOVCircle
        )

        setQuickState(
            QuickButtons.TGT,
            State.AimEnabled
        )
    end
)

-- ================================================================
-- INITIAL STATE
-- ================================================================

updateFOV()

local supported, adapterMessage = checkTridentAdapter()

UI.AdapterStatus:SetTitle(
    supported
        and "Adapter Status · READY"
        or "Adapter Status · CHECK"
)

UI.AdapterStatus:Set(adapterMessage)

notify(
    "OverSeek.wtf",
    "Interface carregada sem nested groups; ESP/FOV foram reorganizados."
)

-- ================================================================
-- CLEANUP
-- ================================================================

local function cleanup()
    if not Running then
        return
    end

    Running = false

    pcall(function()
        RunService:UnbindFromRenderStep(
            SCRIPT_RENDER_NAME
        )
    end)

    disconnectAll()

    for player in pairs(ESP) do
        removeESP(player)
    end

    for player in pairs(HitboxVisuals) do
        removeHitboxVisualizer(player)
    end

    for model in pairs(NPCESP) do
        removeNPCESP(model)
    end

    pcall(function()
        Overlay:Destroy()
    end)

    pcall(function()
        QuickBarGui:Destroy()
    end)

    ExportEnvironment.OverSeek_Cleanup = nil
end

ExportEnvironment.OverSeek_Cleanup = cleanup

-- Combat is intentionally the first tab, so no Navigate() call is necessary.
-- This avoids invoking extra tab bring-into-view logic during startup.
