local QuickButtons = {}

local function setQuickState(button, enabled)
    if not button then
        return
    end

    button.BackgroundColor3 = enabled
        and Color3.fromRGB(0, 88, 160)
        or Color3.fromRGB(28, 30, 36)
end

local function createQuickButton(label, callback)
    local button = Instance.new("TextButton")
    button.Name = "Quick_" .. label
    button.Size = UDim2.fromOffset(50, 42)
    button.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Text = label
    button.AutoButtonColor = true
    button.Parent = QuickBar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    button.Activated:Connect(callback)

    return button
end

QuickButtons.AIM = createQuickButton("AIM", function()
    if State.AimMode == "Off" then
        State.AimMode = "Aimbot"

        if UI.AimMode then
            UI.AimMode:Set("Aimbot")
        end
    end

    State.AimEnabled = not State.AimEnabled

    if UI.AimEnabled then
        UI.AimEnabled:Set(State.AimEnabled)
    end

    setQuickState(
        QuickButtons.AIM,
        State.AimEnabled and State.AimMode == "Aimbot"
    )
end)

QuickButtons.ESP = createQuickButton("ESP", function()
    State.ESPEnabled = not State.ESPEnabled

    if UI.ESPEnabled then
        UI.ESPEnabled:Set(State.ESPEnabled)
    end

    setQuickState(
        QuickButtons.ESP,
        State.ESPEnabled
    )
end)

QuickButtons.FOV = createQuickButton("FOV", function()
    State.FOVCircle = not State.FOVCircle

