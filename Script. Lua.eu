UI.AimMode = Combat:CreateDropdown({
    name = "Aim Mode",
    description = "Escolha o modo de mira. Aimbot é a assistência de câmera; o adapter de Trident apenas verifica compatibilidade.",
    options = {
        "Off",
        "Aimbot",
        "Silent Aim (Trident)",
    },
    value = "Off",
    flag = "AimMode",
    callback = function(value)
        State.AimMode = value

        if value == "Silent Aim (Trident)" then
            local supported, message = checkTridentAdapter()

            if not supported then
                notify("Trident Adapter", message)
                State.AimMode = "Off"
                UI.AimMode:Set("Off")
            else
                notify("Trident Adapter", message)
            end
        end

        if value == "Off" then
            State.AimEnabled = false
            UI.AimEnabled:Set(false)
        end
    end,
})

