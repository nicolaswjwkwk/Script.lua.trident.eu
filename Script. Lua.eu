-- Forward-declared UI labels used by the error guard.
local RuntimeStatusText
local RuntimeLogText
local RuntimeDiagnosticsText

-- ================================================================
-- UTILITY / ERROR GUARD / LIFECYCLE
-- ================================================================

local NOOP = function() end

local function pushRuntimeLog(level, message)
    local stamp = os.date("%H:%M:%S")
    local line = string.format("[%s] [%s] %s", stamp, level, tostring(message))

    table.insert(RuntimeLog, 1, line)
    while #RuntimeLog > 32 do
        table.remove(RuntimeLog)
    end

    LastRuntimeAction = tostring(message)

    if RuntimeLogText then
        RuntimeLogText.Text = table.concat(RuntimeLog, "\n")
    end

    if RuntimeStatusText then
        RuntimeStatusText.Text = string.format(
            "OverSeek.wtf | %d FPS | %s | ERR %d",
            CurrentFPS,
            State.SystemEnabled and "READY" or "STANDBY",
            RuntimeErrorCount
        )
    end
end

local function pushRuntimeError(label, message)
    RuntimeErrorCount += 1
    LastRuntimeError = string.format("%s: %s", tostring(label), tostring(message))

    table.insert(RuntimeErrors, 1, LastRuntimeError)
    while #RuntimeErrors > 12 do
        table.remove(RuntimeErrors)
    end

    pushRuntimeLog("ERROR", LastRuntimeError)

    if RuntimeDiagnosticsText then
        RuntimeDiagnosticsText.Text = string.format(
            "Errors: %d | Last: %s",
            RuntimeErrorCount,
            LastRuntimeError
        )
    end
end

local function safeCall(label, callback, ...)
    if type(callback) ~= "function" then
        return false, "callback inválido"
    end

    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        local message = tostring(err)
        pcall(function()
            if debug and debug.traceback then
                message = debug.traceback(message, 2)
            end
        end)
        return message
    end)

    if not ok then
        pushRuntimeError(label, result)

        if State.ErrorGuard and State.AutoRecovery and RuntimeErrorCount >= 5 then
            State.SystemEnabled = false
            Initialized = false
            pushRuntimeLog("RECOVERY", "Sistema colocado em STANDBY após erros repetidos.")
        end

        return false, result
    end

    return true, result
end

local function connect(signal, callback, label)
    if not signal or type(callback) ~= "function" then
        pushRuntimeError(label or "Connect", "signal/callback inválido")
        return nil
    end

    local connection
    local ok, result = safeCall(label or "Connect", function()
        connection = signal:Connect(function(...)
            safeCall(
                label or "Connection",
                callback,
                ...
            )
        end)
        return connection
    end)

    if ok and connection then
        table.insert(Connections, connection)
        return connection
    end

    return nil
end

local function disconnectConnection(connection)
    if not connection then
        return
    end

    pcall(function()
        if connection.Connected then
            connection:Disconnect()
        end
    end)
end

local function disconnectAll()
    for _, connection in ipairs(Connections) do
        disconnectConnection(connection)
    end

    table.clear(Connections)
end

local function destroyInstance(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function unbindRenderLoop()
    pcall(function()
        RunService:UnbindFromRenderStep(SCRIPT_RENDER_NAME)
    end)
end

local function clearRuntimeObjects()
    unbindRenderLoop()
    disconnectAll()

    for player in pairs(ESP) do
        local data = ESP[player]
        if data then
            destroyInstance(data.Root)
            destroyInstance(data.Snapline)
            destroyInstance(data.Highlight)
        end
        ESP[player] = nil
    end

    for player in pairs(HitboxVisuals) do
        destroyInstance(HitboxVisuals[player])
        HitboxVisuals[player] = nil
    end

    for model in pairs(NPCESP) do
        local data = NPCESP[model]
        if data then
            destroyInstance(data.Root)
        end
        NPCESP[model] = nil
    end
end

local function notify(title, content)
    if not State.Notifications then
        return
    end

    safeCall("Notification", function()
        if Rayfield.Notify then
            Rayfield:Notify({
                title = title,
                content = content,
            })
        elseif Window and Window.Notify then
            Window:Notify({
                title = title,
                content = content,
            })
        end
    end)
end

local function clamp(number, minimum, maximum)
    local n = tonumber(number) or minimum
    return math.max(minimum, math.min(maximum, n))
end

local function round(number)
    local n = tonumber(number) or 0
    return math.floor(n + 0.5)
end

local function getCamera()
    Camera = Workspace.CurrentCamera or Camera
    return Camera
end

local function getGuiParent()
    local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")

    if playerGui then
        return playerGui
    end

    local parent

    pcall(function()
        parent = CoreGui
    end)

    return parent
end

local function getPlatformName()
    if UserInputService.TouchEnabled and UserInputService.KeyboardEnabled then
        return "Touch + Keyboard"
    elseif UserInputService.TouchEnabled then
        return "Touch"
    elseif UserInputService.GamepadEnabled then
        return "Gamepad"
    end
    return "Keyboard / Mouse"
end

local function runtimeUptime()
    return math.max(0, os.clock() - RuntimeStartedAt)
end

-- ================================================================
-- CHARACTER HELPERS
-- ================================================================

local function getCharacter(player)
    if not player then
        return nil
    end

    local character = player.Character

    if character and character.Parent then
        return character
    end

    return Workspace:FindFirstChild(player.Name)
end

local function getHumanoid(character)
    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getPart(character, name)
    if not character then
        return nil
    end

    local object = character:FindFirstChild(name)

    if object and object:IsA("BasePart") then
        return object
    end

    return nil
end

local function getRoot(character)
    return getPart(character, "HumanoidRootPart")
        or getPart(character, "UpperTorso")
        or getPart(character, "Torso")
end

local function getHead(character)
    return getPart(character, "Head")
end

local function isAlive(character)
    local humanoid = getHumanoid(character)

    if not humanoid then
        return false
    end

    return humanoid.Health > 0
end

local function isSleeping(character)
    if not character then
        return false
    end

    for _, attributeName in ipairs({
        "Sleeping",
        "IsSleeping",
        "Downed",
    }) do
        if character:GetAttribute(attributeName) == true then
            return true
        end
    end

    local humanoid = getHumanoid(character)

    if humanoid then
        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.PlatformStanding then
            return true
        end
    end

    return false
end

local function isScientist(character)
    if not character then
        return false
    end

    local lowerName = string.lower(character.Name)

    if string.find(lowerName, "scientist", 1, true) then
        return true
    end

    return character:GetAttribute("Scientist") == true
        or character:GetAttribute("IsScientist") == true
end

local function getDistanceSquared(character)
    local localCharacter = getCharacter(LocalPlayer)
    local localRoot = getRoot(localCharacter)
    local targetRoot = getRoot(character)

    if not localRoot or not targetRoot then
        return math.huge
    end

    local delta = localRoot.Position - targetRoot.Position
    return delta.X * delta.X + delta.Y * delta.Y + delta.Z * delta.Z
end

local function getDistance(character)
    local squared = getDistanceSquared(character)
    if squared == math.huge then
        return math.huge
    end
    return math.sqrt(squared)
end

local RelationshipCache = {}
local RELATIONSHIP_CACHE_TTL = 5
local NativeTeamSystem = false
local NativeTeamSystemCheckedAt = 0
local NATIVE_TEAM_CHECK_TTL = 2

local function hasNativeTeamSystem()
    local now = os.clock()

    if now - NativeTeamSystemCheckedAt <= NATIVE_TEAM_CHECK_TTL then
        return NativeTeamSystem
    end

    local hasTeams = false

    if LocalPlayer and (LocalPlayer.Team ~= nil) then
        hasTeams = true
    else
        pcall(function()
            hasTeams = #TeamsService:GetTeams() > 0
        end)
    end

    NativeTeamSystem = hasTeams
    NativeTeamSystemCheckedAt = now

    return NativeTeamSystem
end

local function playerHasTeamMetadata(player)
    if not player then
        return false
    end

    return hasNativeTeamSystem()
        or player.Team ~= nil
        or LocalPlayer.Team ~= nil
end

local function sameConfiguredGroup(player)
    local groupId = tonumber(State.FallbackGroupId) or 0

    if groupId <= 0 or not player or not LocalPlayer then
        return false
    end

    local localRank = 0
    local targetRank = 0

    local ok = pcall(function()
        localRank = LocalPlayer:GetRankInGroup(groupId)
        targetRank = player:GetRankInGroup(groupId)
    end)

    return ok and localRank > 0 and targetRank > 0
end

local function isFriend(player)
    if not player or not LocalPlayer then
        return false
    end

    local result = false
    local ok = pcall(function()
        result = LocalPlayer:IsFriendsWith(player.UserId)
    end)

    return ok and result == true
end

local function getRelationship(player)
    if not player or player == LocalPlayer then
        return "Self"
    end

    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        return player.Team == LocalPlayer.Team and "Teammate" or "Enemy"
    end

    if playerHasTeamMetadata(player)
        and player.TeamColor ~= nil
        and LocalPlayer.TeamColor ~= nil then
        return player.TeamColor == LocalPlayer.TeamColor and "Teammate" or "Enemy"
    end

    local cached = RelationshipCache[player]

    if cached then
        return cached.value
    end

    -- No native team information and no background relationship result yet.
    return "Enemy"
end

local function isTeammate(player)
    return getRelationship(player) == "Teammate"
end

local function shouldIncludeByTeam(player)
    local relationship = getRelationship(player)

    if State.TeamFilter == "All" then
        return true
    end

    if State.TeamFilter == "Teammates Only" then
        return relationship == "Teammate"
    end

    return relationship ~= "Teammate"
end

local function getESPColor(player)
    local relationship = getRelationship(player)

    if relationship == "Teammate" then
        return State.AllyColor
    end

    if relationship == "Enemy" then
        if State.TeamColorMode == "Relationship" then
            return State.EnemyColor
        end

        if State.TeamColorMode == "Auto" then
            local teamColor = player and player.TeamColor
            if teamColor and playerHasTeamMetadata(player) then
                return teamColor.Color
            end
            return State.EnemyColor
        end

        return State.EnemyColor
    end

    return State.NeutralColor
end

local function refreshRelationshipCache()
    if not LocalPlayer then
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not playerHasTeamMetadata(player) then
            local relationship = "Enemy"

            if sameConfiguredGroup(player) or isFriend(player) then
                relationship = "Teammate"
            end

            RelationshipCache[player] = {
                time = os.clock(),
                value = relationship,
            }
        end
    end
end

local function startRelationshipWorker()
    if RelationshipWorker then
        return
    end

    RelationshipWorker = task.spawn(function()
        while Running do
            task.wait(5)
            if not Running then
                break
            end

            pcall(refreshRelationshipCache)
        end

        RelationshipWorker = nil
    end)
end

local function withinRenderDistance(character)
    return getDistance(character) <= State.RenderDistance
end

local function getTargetPart(character)
    local requested = getPart(character, State.HitPart)

    if requested then
        return requested
    end

    return getRoot(character) or getHead(character)
end

-- ================================================================
-- AIM POINT - precisa ficar na cabeça
-- ================================================================

local function getAimPoint(character)
    if not character then
        return nil
    end

    local head = getHead(character)

    if State.AimPoint == "Head Top" then
        if head then
            -- CFrame.UpVector mantém o ponto no topo mesmo se a cabeça estiver inclinada.
            return head.Position + head.CFrame.UpVector * (head.Size.Y * 0.42)
        end
    elseif State.AimPoint == "Head Center" then
        if head then
            return head.Position
        end
    elseif State.AimPoint == "Body Center" then
        local root = getRoot(character)

        if root then
            return root.Position
        end
    end

    local targetPart = getTargetPart(character)

    return targetPart and targetPart.Position or nil
end

-- ================================================================
-- TARGET RESOLVER
-- ================================================================

local function getScreenCenter()
    local camera = getCamera()

    if not camera then
        return Vector2.zero
    end

    local viewport = camera.ViewportSize

    return Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )
end

local function validTarget(player, character)
    if not player or player == LocalPlayer then
        return false
    end

    if not character or not character.Parent then
        return false
    end

    if not isAlive(character) then
        return false
    end

    if not withinRenderDistance(character) then
        return false
    end

    if not shouldIncludeByTeam(player) then
        return false
    end

    if isSleeping(character) and not State.TargetSleeping then
        return false
    end

    return true
end

local function findClosestTarget(requireAimEnabled)
    if not State.SystemEnabled then
        return nil
    end

    if requireAimEnabled and not State.AimEnabled then
        return nil
    end

    if requireAimEnabled and State.AimMode == "Off" then
        return nil
    end

    local camera = getCamera()

    if not camera then
        return nil
    end

    local center = getScreenCenter()
    local best = nil
    local bestDistance = State.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = getCharacter(player)

            if validTarget(player, character) then
                local aimPosition = getAimPoint(character)

                if aimPosition then
                    local screenPoint, visible =
                        camera:WorldToViewportPoint(aimPosition)

                    if visible and screenPoint.Z > 0 then
                        local point = Vector2.new(
                            screenPoint.X,
                            screenPoint.Y
                        )

                        local screenDistance =
                            (point - center).Magnitude

                        if screenDistance <= bestDistance then
                            bestDistance = screenDistance

                            best = {
                                player = player,
                                character = character,
                                position = aimPosition,
                                screenPoint = point,
                                screenDistance = screenDistance,
                                worldDistance = getDistance(character),
                                relationship = getRelationship(player),
                            }
                        end
                    end
                end
            end
        end
    end

    return best
end

local function getClosestTarget()
    return findClosestTarget(true)
end

-- Resolver export stays disabled by default to reduce global surface area.
local function updateResolverExport()
    if State.ExportResolver and State.DevUnlocked then
        RuntimeEnv.OverSeek_GetTarget = getClosestTarget
    else
        pcall(function()
            if RuntimeEnv.OverSeek_GetTarget then
                RuntimeEnv.OverSeek_GetTarget = nil
            end
        end)
    end
end

-- ================================================================
-- TRIDENT ADAPTER CHECK
-- ================================================================

local function checkTridentAdapter()
    local placeMatches = game.PlaceId == TRIDENT_PLACE_ID

    if State.RuntimeProfile == "Universal" then
        return true, "Perfil Universal selecionado. Sem dependências internas de Trident."
    end

    if State.RuntimeProfile == "Trident" and not placeMatches then
        return false, "Perfil Trident selecionado, mas o PlaceId atual não corresponde ao adapter."
    end

    if not placeMatches then
        return true, "Outro jogo detectado. Perfil Auto/Universal disponível; Trident não será ativado."
    end

    local checks = {}

    local function hasFunction(name)
        local exists = false

        pcall(function()
            exists = type(_G[name]) == "function"
        end)

        if not exists then
            pcall(function()
                if typeof(getgenv) == "function" then
                    local env = getgenv()
                    exists = type(env[name]) == "function"
                end
            end)
        end

        return exists
    end

    for _, name in ipairs({
        "getactors",
        "run_on_actor",
        "hookfunction",
    }) do
        table.insert(checks, {
            name = name,
            ok = hasFunction(name),
        })
    end

    local playerGuiOk = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui") ~= nil
    local cameraOk = getCamera() ~= nil
    local missing = {}

    if not playerGuiOk then
        table.insert(missing, "PlayerGui")
    end

    if not cameraOk then
        table.insert(missing, "CurrentCamera")
    end

    for _, item in ipairs(checks) do
        if not item.ok then
            table.insert(missing, item.name)
        end
    end

    if State.RuntimeProfile == "Trident" and #missing > 0 then
        return false, "Trident detectado, mas faltam primitivas opcionais: " .. table.concat(missing, ", ")
    end

    if #missing > 0 then
        return true, "Trident detectado; adapter de compatibilidade em CHECK (sem hooks instalados)."
    end

    return true, "Trident detectado e ambiente expõe as primitivas opcionais; adapter permanece somente como verificação."
end

