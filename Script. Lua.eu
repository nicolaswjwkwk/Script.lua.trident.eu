local ESPAccumulator = 0
local NPCAccumulator = 0
local ValidationAccumulator = 0
local RuntimeStartedAt = os.clock()
local RuntimeErrorCount = 0
local LastRuntimeError = "none"
local LastRuntimeAction = "boot"
