end)()
cheat.SaveManager = (function()
    local m = {}
    function m:SetLibrary(lib) end
    function m:SetFolder(folder) end
    function m:SetOptionsTEMP(opts, toggles) end
    function m:IgnoreThemeSettings() end
    function m:BuildConfigSection(tab) end
    return m
end)()

