local function updateFOV()
    local camera = getCamera()

    if not camera then
        FOVCircle.Visible = false
        return
    end

    local viewport = camera.ViewportSize

    FOVCircle.Position = UDim2.fromOffset(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local diameter = clamp(State.FOVRadius * 2, 2, 1200)

    FOVCircle.Size = UDim2.fromOffset(
        diameter,
        diameter
    )

    FOVCircle.Visible =
        State.FOVCircle
        and State.FOVRadius > 0
end

