local FOVStroke = Instance.new("UIStroke")
FOVStroke.Thickness = 1.5
FOVStroke.Transparency = 0
FOVStroke.Color = State.FOVColor
FOVStroke.Parent = FOVCircle

local FOVTargetLine = Instance.new("Frame")
FOVTargetLine.Name = "FOVTargetLine"
FOVTargetLine.AnchorPoint = Vector2.new(0, 0.5)
FOVTargetLine.BackgroundTransparency = 0
FOVTargetLine.BorderSizePixel = 0
FOVTargetLine.Size = UDim2.fromOffset(0, State.FOVLineThickness)
FOVTargetLine.Visible = false
FOVTargetLine.ZIndex = 99
FOVTargetLine.Parent = Overlay

local FOVTargetDot = Instance.new("Frame")
FOVTargetDot.Name = "FOVTargetDot"
FOVTargetDot.AnchorPoint = Vector2.new(0.5, 0.5)
FOVTargetDot.BackgroundColor3 = State.FOVColor
FOVTargetDot.BorderSizePixel = 0
FOVTargetDot.Size = UDim2.fromOffset(7, 7)
FOVTargetDot.Visible = false
FOVTargetDot.ZIndex = 100
FOVTargetDot.Parent = Overlay

local FOVDotCorner = Instance.new("UICorner")
FOVDotCorner.CornerRadius = UDim.new(1, 0)
FOVDotCorner.Parent = FOVTargetDot

local function updateFOV()
    local camera = getCamera()

    if not camera then
        FOVCircle.Visible = false
        return
    end

    local viewport = camera.ViewportSize

    FOVCircle.Position = UDim2.fromOffset(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )

    local diameter = clamp(State.FOVRadius * 2, 2, 1200)

    FOVCircle.Size = UDim2.fromOffset(
        diameter,
        diameter
    )

    FOVStroke.Color = State.FOVColor
    FOVCircle.Visible =
        State.SystemEnabled
        and State.FOVCircle
        and State.FOVRadius > 0

    FOVTargetLine.Visible = false
    FOVTargetDot.Visible = false
end

local function updateFOVTargetIndicator()
    if not State.SystemEnabled then
        FOVTargetLine.Visible = false
        FOVTargetDot.Visible = false
        return
    end

    if not State.FOVTargetLine and not State.FOVTargetDot then
        FOVTargetLine.Visible = false
        FOVTargetDot.Visible = false
        return
    end

    local camera = getCamera()
    if not camera then
        FOVTargetLine.Visible = false
        FOVTargetDot.Visible = false
        return
    end

    local target = findClosestTarget(false)
    if not target or not target.screenPoint then
        FOVTargetLine.Visible = false
        FOVTargetDot.Visible = false
        return
    end

    local center = getScreenCenter()
    local destination = target.screenPoint
    local delta = destination - center
    local length = delta.Magnitude

    if State.FOVTargetLine and length > 2 then
        FOVTargetLine.Position = UDim2.fromOffset(center.X, center.Y)
        FOVTargetLine.Size = UDim2.fromOffset(length, clamp(State.FOVLineThickness, 1, 5))
        FOVTargetLine.Rotation = math.deg(math.atan2(delta.Y, delta.X))
        FOVTargetLine.BackgroundColor3 = getESPColor(target.player)
        FOVTargetLine.Visible = true
    else
        FOVTargetLine.Visible = false
    end

    if State.FOVTargetDot then
        FOVTargetDot.Position = UDim2.fromOffset(destination.X, destination.Y)
        FOVTargetDot.BackgroundColor3 = getESPColor(target.player)
        FOVTargetDot.Visible = true
    else
        FOVTargetDot.Visible = false
    end
end

