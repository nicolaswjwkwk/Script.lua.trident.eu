-- ================================================================
-- UTILITY
-- ================================================================

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(Connections, c)
    return c
end

local function disconnectAll()
    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)
end

local function notify(title, content)
    if not State.Notifications then
        return
    end

    pcall(function()
        Window:Notify({
            title = title,
            content = content,
        })
    end)
end

local function clamp(number, minimum, maximum)
    return math.max(minimum, math.min(maximum, number))
end

local function round(number)
    return math.floor(number + 0.5)
end

local function getCamera()
    Camera = Workspace.CurrentCamera or Camera
    return Camera
end

local function getGuiParent()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")

    if playerGui then
        return playerGui
    end

    local parent

    pcall(function()
        parent = CoreGui
    end)

    return parent or LocalPlayer:WaitForChild("PlayerGui")
end

-- ================================================================
-- CHARACTER HELPERS
-- ================================================================

local function getCharacter(player)
    if not player then
        return nil
    end

    local character = player.Character

    if character and character.Parent then
        return character
    end

    return Workspace:FindFirstChild(player.Name)
end

local function getHumanoid(character)
    if not character then
        return nil
    end

    return character:FindFirstChildOfClass("Humanoid")
end

local function getPart(character, name)
    if not character then
        return nil
    end

    local object = character:FindFirstChild(name)

    if object and object:IsA("BasePart") then
        return object
    end

    return nil
end

local function getRoot(character)
    return getPart(character, "HumanoidRootPart")
        or getPart(character, "UpperTorso")
        or getPart(character, "Torso")
end

local function getHead(character)
    return getPart(character, "Head")
end

local function isAlive(character)
    local humanoid = getHumanoid(character)

    if not humanoid then
        return false
    end

    return humanoid.Health > 0
end

local function isSleeping(character)
    if not character then
        return false
    end

    for _, attributeName in ipairs({
        "Sleeping",
        "IsSleeping",
        "Downed",
    }) do
        if character:GetAttribute(attributeName) == true then
            return true
        end
    end

    local humanoid = getHumanoid(character)

    if humanoid then
        local state = humanoid:GetState()

        if state == Enum.HumanoidStateType.PlatformStanding then
            return true
        end
    end

    return false
end

local function isScientist(character)
    if not character then
        return false
    end

    local lowerName = string.lower(character.Name)

    if string.find(lowerName, "scientist", 1, true) then
        return true
    end

    return character:GetAttribute("Scientist") == true
        or character:GetAttribute("IsScientist") == true
end

local function getDistance(character)
    local localCharacter = getCharacter(LocalPlayer)
    local localRoot = getRoot(localCharacter)
    local targetRoot = getRoot(character)

    if not localRoot or not targetRoot then
        return math.huge
    end

    return (localRoot.Position - targetRoot.Position).Magnitude
end

local function isTeammate(player)
    if not player or not LocalPlayer then
        return false
    end

    if player.Team ~= nil and LocalPlayer.Team ~= nil then
        return player.Team == LocalPlayer.Team
    end

    if player.TeamColor ~= nil and LocalPlayer.TeamColor ~= nil then
        return player.TeamColor == LocalPlayer.TeamColor
    end

    return false
end

local function withinRenderDistance(character)
    return getDistance(character) <= State.RenderDistance
end

local function getTargetPart(character)
    local requested = getPart(character, State.HitPart)

    if requested then
        return requested
    end

    return getRoot(character) or getHead(character)
end

-- ================================================================
-- AIM POINT - precisa ficar na cabeça
-- ================================================================

local function getAimPoint(character)
    if not character then
        return nil
    end

    local head = getHead(character)

    if State.AimPoint == "Head Top" then
        if head then
            -- CFrame.UpVector mantém o ponto no topo mesmo se a cabeça estiver inclinada.
            return head.Position + head.CFrame.UpVector * (head.Size.Y * 0.42)
        end
    elseif State.AimPoint == "Head Center" then
        if head then
            return head.Position
        end
    elseif State.AimPoint == "Body Center" then
        local root = getRoot(character)

        if root then
            return root.Position
        end
    end

    local targetPart = getTargetPart(character)

    return targetPart and targetPart.Position or nil
end

-- ================================================================
-- TARGET RESOLVER
-- ================================================================

local function getScreenCenter()
    local camera = getCamera()

    if not camera then
        return Vector2.zero
    end

    local viewport = camera.ViewportSize

    return Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    )
end

local function validTarget(player, character)
    if not player or player == LocalPlayer then
        return false
    end

    if not character or not character.Parent then
        return false
    end

    if not isAlive(character) then
        return false
    end

    if not withinRenderDistance(character) then
        return false
    end

    if not State.Teammates and isTeammate(player) then
        return false
    end

    if isSleeping(character) and not State.TargetSleeping then
        return false
    end

    return true
end

local function getClosestTarget()
    if not State.AimEnabled then
        return nil
    end

    if State.AimMode == "Off" then
        return nil
    end

    local camera = getCamera()

    if not camera then
        return nil
    end

    local center = getScreenCenter()
    local best = nil
    local bestDistance = State.FOVRadius

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = getCharacter(player)

            if validTarget(player, character) then
                local aimPosition = getAimPoint(character)

                if aimPosition then
                    local screenPoint, visible =
                        camera:WorldToViewportPoint(aimPosition)

                    if visible and screenPoint.Z > 0 then
                        local point = Vector2.new(
                            screenPoint.X,
                            screenPoint.Y
                        )

                        local screenDistance =
                            (point - center).Magnitude

                        if screenDistance <= bestDistance then
                            bestDistance = screenDistance

                            best = {
                                player = player,
                                character = character,
                                position = aimPosition,
                                screenDistance = screenDistance,
                                worldDistance = getDistance(character),
                            }
                        end
                    end
                end
            end
        end
    end

    return best
end

-- Exports target resolver so an experience you control can consume the same target logic.
local ExportEnvironment = _G

pcall(function()
    if typeof(getgenv) == "function" then
        local env = getgenv()

        if type(env) == "table" then
            ExportEnvironment = env
        end
    end
end)

ExportEnvironment.OverSeek_GetTarget = getClosestTarget

-- ================================================================
-- TRIDENT ADAPTER CHECK
-- ================================================================

local function checkTridentAdapter()
    if game.PlaceId ~= TRIDENT_PLACE_ID then
        return false, "Outro jogo detectado. O adapter de Trident não é usado aqui."
    end

    -- Only report whether the environment exposes the optional primitives.
    -- No projectile hook is installed by this universal layer.
    local available = {}

    for _, name in ipairs({
        "getactors",
        "run_on_actor",
        "hookfunction",
    }) do
        local exists = false

        pcall(function()
            exists = type(_G[name]) == "function"
        end)

        if not exists then
            pcall(function()
                if typeof(getgenv) == "function" then
                    local env = getgenv()
                    exists = type(env[name]) == "function"
                end
            end)
        end

        table.insert(available, {
            name = name,
            ok = exists,
        })
    end

    local missing = {}

    for _, item in ipairs(available) do
        if not item.ok then
            table.insert(missing, item.name)
        end
    end

    if #missing > 0 then
        return false,
            "Trident detectado, mas o ambiente não expõe: " .. table.concat(missing, ", ")
    end

    return true,
        "Trident detectado e primitivas opcionais estão disponíveis."
end

