--[[
    ================================================================
    OVERSEEK.WTF - RAYFIELD GEN2 / STABLE PRO LAYOUT - V3
    ================================================================

    Correções desta versão:
      1. Remove dependências de elementos que não são usados por esta versão Gen2.
      2. Remove nested CreateGroup do layout principal para evitar o erro
         uso de nested groups que causava conflitos de layout no runtime.
      3. ESP 2D usa os BODY PARTS do personagem, em vez de offsets fixos.
         Isso deixa a caixa proporcional ao corpo e reduz corretamente com a distância.
      4. O nome/distância ficam presos no topo da caixa, não na cabeça.
      5. FOV é um círculo de UI real, reposicionado no centro da viewport a cada frame.
      6. Aim Point "Head Top" mira na parte superior da cabeça.
      7. Aimbot usa câmera local e o resolver usa a mesma lógica de alvo/FOV.
      8. Trident Adapter possui gates de disponibilidade e validação defensiva; não instala
         hooks de projétil externos nesta camada universal.
      9. Save/Load é estritamente manual: nada é salvo sem ação explícita do usuário.
     10. Sistema de inicialização, watchdog, error guard, cleanup idempotente e diagnóstico.
     11. Team resolver separado da ativação de mira; FOV/ESP não dependem de Aim Enabled.
     12. Linha de alvo dentro do FOV, cores por relação/time e profundidade do Highlight.
     13. Aba Developer protegida por chave local e sem exposição do resolver por padrão.

    Compatibilidade:
      - UI: Rayfield Gen2 estável.
      - ESP/FOV/target resolver: estruturas padrão do Roblox.
      - Mecânicas internas de armas não são presumidas como universais.
    ================================================================
]]

-- ================================================================
-- SERVICES
-- ================================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local TeamsService = game:GetService("Teams")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local TRIDENT_PLACE_ID = 13253735473
local SCRIPT_RENDER_NAME = "OverSeek_Aimbot_Render"
local SCRIPT_CONNECTION_PREFIX = "OverSeek_"

-- ================================================================
-- RUNTIME ENV / PREVIOUS INSTANCE CLEANUP
-- ================================================================

local RuntimeEnv = _G
pcall(function()
    if typeof(getgenv) == "function" then
        local env = getgenv()
        if type(env) == "table" then
            RuntimeEnv = env
        end
    end
end)

local function safeInvoke(label, callback, ...)
    local args = table.pack(...)

    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        local message = tostring(err)
        pcall(function()
            if debug and debug.traceback then
                message = debug.traceback(message, 2)
            end
        end)
        return message
    end)

    if not ok then
        return false, result
    end

    return true, result
end

-- A previous instance must release its own render binding/overlays first.
pcall(function()
    if type(RuntimeEnv.OverSeek_Cleanup) == "function" then
        RuntimeEnv.OverSeek_Cleanup()
    end
end)

RuntimeEnv.OverSeek_Cleanup = nil

-- ================================================================
-- RAYFIELD GEN2
-- ================================================================

