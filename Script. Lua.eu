-- ================================================================
-- BODY-PART BOUNDING BOX
-- ================================================================

local BODY_PART_NAMES = {
    "Head",
    "UpperTorso",
    "LowerTorso",
    "Torso",
    "HumanoidRootPart",
    "LeftUpperArm",
    "LeftLowerArm",
    "LeftHand",
    "RightUpperArm",
    "RightLowerArm",
    "RightHand",
    "LeftUpperLeg",
    "LeftLowerLeg",
    "LeftFoot",
    "RightUpperLeg",
    "RightLowerLeg",
    "RightFoot",
    "Left Arm",
    "Right Arm",
    "Left Leg",
    "Right Leg",
}

local function projectPartBounds(camera, part, minX, minY, maxX, maxY)
    local half = part.Size * 0.5

    local corners = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y, half.Z),
        Vector3.new(-half.X, half.Y, -half.Z),
        Vector3.new(-half.X, half.Y, half.Z),
        Vector3.new(half.X, -half.Y, -half.Z),
        Vector3.new(half.X, -half.Y, half.Z),
        Vector3.new(half.X, half.Y, -half.Z),
        Vector3.new(half.X, half.Y, half.Z),
    }

    local anyFront = false

    for _, localPoint in ipairs(corners) do
        local worldPoint = part.CFrame:PointToWorldSpace(localPoint)
        local screenPoint = camera:WorldToViewportPoint(worldPoint)

        if screenPoint.Z > 0 then
            anyFront = true
            minX = math.min(minX, screenPoint.X)
            minY = math.min(minY, screenPoint.Y)
            maxX = math.max(maxX, screenPoint.X)
            maxY = math.max(maxY, screenPoint.Y)
        end
    end

    return minX, minY, maxX, maxY, anyFront
end

local function projectBodyBoundingBox(character)
    if not character then
        return nil
    end

    local camera = getCamera()

    if not camera then
        return nil
    end

    local minimumX = math.huge
    local minimumY = math.huge
    local maximumX = -math.huge
    local maximumY = -math.huge
    local foundBodyPart = false

    for _, name in ipairs(BODY_PART_NAMES) do
        local part = character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            local partMinX, partMinY, partMaxX, partMaxY, partInFront =
                projectPartBounds(
                    camera,
                    part,
                    minimumX,
                    minimumY,
                    maximumX,
                    maximumY
                )

            minimumX = partMinX
            minimumY = partMinY
            maximumX = partMaxX
            maximumY = partMaxY

            if partInFront then
                foundBodyPart = true
            end
        end
    end

    -- Fallback: some games use custom body part names.
    if not foundBodyPart then
        local ok, boxCFrame, boxSize =
            pcall(function()
                return character:GetBoundingBox()
            end)

        if not ok or not boxCFrame or not boxSize then
            return nil
        end

        local half = boxSize * 0.5

        local corners = {
            Vector3.new(-half.X, -half.Y, -half.Z),
            Vector3.new(-half.X, -half.Y, half.Z),
            Vector3.new(-half.X, half.Y, -half.Z),
            Vector3.new(-half.X, half.Y, half.Z),
            Vector3.new(half.X, -half.Y, -half.Z),
            Vector3.new(half.X, -half.Y, half.Z),
            Vector3.new(half.X, half.Y, -half.Z),
            Vector3.new(half.X, half.Y, half.Z),
        }

        for _, localPoint in ipairs(corners) do
            local worldPoint = boxCFrame:PointToWorldSpace(localPoint)
            local screenPoint = camera:WorldToViewportPoint(worldPoint)

            if screenPoint.Z > 0 then
                foundBodyPart = true
                minimumX = math.min(minimumX, screenPoint.X)
                minimumY = math.min(minimumY, screenPoint.Y)
                maximumX = math.max(maximumX, screenPoint.X)
                maximumY = math.max(maximumY, screenPoint.Y)
            end
        end
    end

    if not foundBodyPart then
        return nil
    end

    local width = maximumX - minimumX
    local height = maximumY - minimumY

    if width <= 1 or height <= 1 then
        return nil
    end

    local viewport = camera.ViewportSize

    -- Keep the visible box on the drawable screen when a body is partially offscreen.
    minimumX = clamp(minimumX, -width, viewport.X + width)
    minimumY = clamp(minimumY, -height, viewport.Y + height)
    maximumX = clamp(maximumX, -width, viewport.X + width)
    maximumY = clamp(maximumY, -height, viewport.Y + height)

    return {
        x = minimumX,
        y = minimumY,
        width = maximumX - minimumX,
        height = maximumY - minimumY,
    }
end

-- ================================================================
-- 2D BOX BUILDER
-- ================================================================

local function makeLine(parent, name)
    local line = Instance.new("Frame")
    line.Name = name
    line.BorderSizePixel = 0
    line.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    line.Size = UDim2.fromOffset(1.5, 1.5)
    line.Parent = parent

    return line
end

local function createCornerBox(parent)
    local holder = Instance.new("Frame")
    holder.Name = "CornerBox"
    holder.BackgroundTransparency = 1
    holder.BorderSizePixel = 0
    holder.Visible = false
    holder.Parent = parent

    local thickness = 2
    local cornerRatio = 0.20

    local TL_H = makeLine(holder, "TL_H")
    local TL_V = makeLine(holder, "TL_V")
    local TR_H = makeLine(holder, "TR_H")
    local TR_V = makeLine(holder, "TR_V")
    local BL_H = makeLine(holder, "BL_H")
    local BL_V = makeLine(holder, "BL_V")
    local BR_H = makeLine(holder, "BR_H")
    local BR_V = makeLine(holder, "BR_V")

    local parts = {
        TL_H, TL_V, TR_H, TR_V,
        BL_H, BL_V, BR_H, BR_V,
    }

    local function apply(width, height, color)
        local horizontal = math.max(8, width * cornerRatio)
        local vertical = math.max(8, height * cornerRatio)

        TL_H.Position = UDim2.fromOffset(0, 0)
        TL_H.Size = UDim2.fromOffset(horizontal, thickness)

        TL_V.Position = UDim2.fromOffset(0, 0)
        TL_V.Size = UDim2.fromOffset(thickness, vertical)

        TR_H.Position = UDim2.fromOffset(width - horizontal, 0)
        TR_H.Size = UDim2.fromOffset(horizontal, thickness)

        TR_V.Position = UDim2.fromOffset(width - thickness, 0)
        TR_V.Size = UDim2.fromOffset(thickness, vertical)

        BL_H.Position = UDim2.fromOffset(0, height - thickness)
        BL_H.Size = UDim2.fromOffset(horizontal, thickness)

        BL_V.Position = UDim2.fromOffset(0, height - vertical)
        BL_V.Size = UDim2.fromOffset(thickness, vertical)

        BR_H.Position = UDim2.fromOffset(width - horizontal, height - thickness)
        BR_H.Size = UDim2.fromOffset(horizontal, thickness)

        BR_V.Position = UDim2.fromOffset(width - thickness, height - vertical)
        BR_V.Size = UDim2.fromOffset(thickness, vertical)

        for _, line in ipairs(parts) do
            line.BackgroundColor3 = color
        end
    end

    return holder, apply
end

-- ================================================================
-- ESP OBJECTS
-- ================================================================

local function removeESP(player)
    local data = ESP[player]

    if not data then
        return
    end

    if data.Root then
        data.Root:Destroy()
    end

    if data.Snapline then
        data.Snapline:Destroy()
    end

    if data.Highlight then
        data.Highlight:Destroy()
    end

    ESP[player] = nil
end

local function createESP(player)
    if ESP[player] then
        return ESP[player]
    end

    local root = Instance.new("Frame")
    root.Name = "ESP_" .. player.Name
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.Size = UDim2.fromOffset(1, 1)
    root.Visible = false
    root.ZIndex = 90
    root.Parent = Overlay

    local outline = Instance.new("Frame")
    outline.Name = "Box"
    outline.BackgroundTransparency = 1
    outline.BorderSizePixel = 1
    outline.Visible = false
    outline.Parent = root

    local outlineStroke = Instance.new("UIStroke")
    outlineStroke.Thickness = 1.4
    outlineStroke.Parent = outline

    local cornerBox, updateCornerBox = createCornerBox(root)

    local info = Instance.new("TextLabel")
    info.Name = "Info"
    info.AnchorPoint = Vector2.new(0.5, 1)
    info.BackgroundTransparency = 1
    info.TextColor3 = Color3.new(1, 1, 1)
    info.TextStrokeTransparency = 0.20
    info.Font = Enum.Font.GothamBold
    info.TextSize = 13
    info.TextXAlignment = Enum.TextXAlignment.Center
    info.TextYAlignment = Enum.TextYAlignment.Bottom
    info.Visible = false
    info.ZIndex = 95
    info.Parent = root

    local snapline = Instance.new("Frame")
    snapline.Name = "Snapline"
    snapline.AnchorPoint = Vector2.new(0, 0.5)
    snapline.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    snapline.BorderSizePixel = 0
    snapline.Size = UDim2.fromOffset(0, 1.5)
    snapline.Visible = false
    snapline.ZIndex = 85
    snapline.Parent = Overlay

    local highlight = Instance.new("Highlight")
    highlight.Name = "OverSeekHighlight"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.Enabled = false
    highlight.Parent = Overlay

    local data = {
        Root = root,
        Outline = outline,
        OutlineStroke = outlineStroke,
        CornerBox = cornerBox,
        UpdateCornerBox = updateCornerBox,
        Info = info,
        Snapline = snapline,
        Highlight = highlight,
    }

    ESP[player] = data

    return data
end

local function updateSnapline(line, destination, color)
    local center = getScreenCenter()
    local delta = destination - center
    local length = delta.Magnitude

    if length <= 2 then
        line.Visible = false
        return
    end

    line.Position = UDim2.fromOffset(
        center.X,
        center.Y
    )

    line.Size = UDim2.fromOffset(
        length,
        1.5
    )

    line.Rotation = math.deg(
        math.atan2(delta.Y, delta.X)
    )

    line.BackgroundColor3 = color
    line.Visible = true
end

local function updateESPPlayer(player)
    if player == LocalPlayer then
        return
    end

    local data = createESP(player)
    local character = getCharacter(player)
    local rootPart = getRoot(character)

    if not State.ESPEnabled and not State.Snapline then
        data.Root.Visible = false
        data.Snapline.Visible = false
        data.Highlight.Enabled = false
        return
    end

    if not character
        or not character.Parent
        or not isAlive(character)
        or not withinRenderDistance(character) then

        data.Root.Visible = false
        data.Snapline.Visible = false
        data.Highlight.Enabled = false
        return
    end

    if not State.Teammates and isTeammate(player) then
        data.Root.Visible = false
        data.Snapline.Visible = false
        data.Highlight.Enabled = false
        return
    end

    local color =
        (player.TeamColor and player.TeamColor.Color)
        or Color3.fromRGB(0, 150, 255)

    local box = projectBodyBoundingBox(character)

    if box then
        data.Root.Visible = State.ESPEnabled
        data.Root.Position = UDim2.fromOffset(box.x, box.y)
        data.Root.Size = UDim2.fromOffset(box.width, box.height)

        data.Outline.Visible =
            State.ESPEnabled
            and State.Box
            and not State.CornerBoxes

        data.OutlineStroke.Color = color

        data.CornerBox.Visible =
            State.ESPEnabled
            and State.Box
            and State.CornerBoxes

        if data.CornerBox.Visible then
            data.CornerBox.Size = UDim2.fromOffset(
                box.width,
                box.height
            )

            data.UpdateCornerBox(
                box.width,
                box.height,
                color
            )
        end

        local information = {}

        if State.ShowName then
            table.insert(information, player.Name)
        end

        if State.ShowDistance then
            table.insert(
                information,
                string.format(
                    "%dm",
                    round(getDistance(character))
                )
            )
        end

        if State.ShowSleeping and isSleeping(character) then
            table.insert(information, "SLEEPING")
        end

        if State.ShowScientists and isScientist(character) then
            table.insert(information, "SCIENTIST")
        end

        if State.ShowGun then
            local tool = character:FindFirstChildOfClass("Tool")

            table.insert(
                information,
                tool and tool.Name or "No Gun"
            )
        end

        data.Info.Text = table.concat(
            information,
            " | "
        )

        data.Info.TextColor3 = color
        data.Info.Position = UDim2.new(
            0.5,
            0,
            0,
            -4
        )

        data.Info.Size = UDim2.fromOffset(
            math.max(120, box.width + 100),
            18
        )

        data.Info.Visible =
            State.ESPEnabled
            and #information > 0
    else
        data.Root.Visible = false
        data.Highlight.Enabled = false
    end

    if State.Outline then
        data.Highlight.Adornee = character
        data.Highlight.OutlineColor = color
        data.Highlight.Enabled = true
    else
        data.Highlight.Enabled = false
    end

    if State.Snapline and rootPart then
        local camera = getCamera()

        if camera then
            local point, visible =
                camera:WorldToViewportPoint(
                    rootPart.Position
                )

            if visible and point.Z > 0 then
                updateSnapline(
                    data.Snapline,
                    Vector2.new(
                        point.X,
                        point.Y
                    ),
                    color
                )
            else
                data.Snapline.Visible = false
            end
        end
    else
        data.Snapline.Visible = false
    end
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        updateESPPlayer(player)
    end

    for player in pairs(ESP) do
        if not player.Parent then
            removeESP(player)
        end
    end
end

-- ================================================================
-- SCIENTIST NPC ESP
-- ================================================================

local NPCESP = {}

local function getNPCModels()
    local result = {}

    if not State.ShowScientists then
        return result
    end

    for _, object in ipairs(Workspace:GetChildren()) do
        if object:IsA("Model") then
            local humanoid = getHumanoid(object)
            local root = getRoot(object)

            if humanoid
                and root
                and humanoid.Health > 0
                and isScientist(object) then

                table.insert(result, object)
            end
        end
    end

    return result
end

local function createNPCESP(model)
    if NPCESP[model] then
        return NPCESP[model]
    end

    local root = Instance.new("Frame")
    root.Name = "NPCESP_" .. model.Name
    root.BackgroundTransparency = 1
    root.BorderSizePixel = 0
    root.Visible = false
    root.ZIndex = 90
    root.Parent = Overlay

    local box = Instance.new("Frame")
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 1
    box.Visible = false
    box.Parent = root

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.4
    stroke.Color = Color3.fromRGB(0, 150, 255)
    stroke.Parent = box

    local info = Instance.new("TextLabel")
    info.AnchorPoint = Vector2.new(0.5, 1)
    info.BackgroundTransparency = 1
    info.Font = Enum.Font.GothamBold
    info.TextSize = 13
    info.TextStrokeTransparency = 0.2
    info.TextColor3 = Color3.fromRGB(0, 150, 255)
    info.Visible = false
    info.Parent = root

    local data = {
        Root = root,
        Box = box,
        Info = info,
    }

    NPCESP[model] = data

    return data
end

local function removeNPCESP(model)
    local data = NPCESP[model]

    if data then
        data.Root:Destroy()
        NPCESP[model] = nil
    end
end

local function updateScientistESP()
    if not State.ESPEnabled or not State.ShowScientists then
        for model in pairs(NPCESP) do
            removeNPCESP(model)
        end
        return
    end

    local seen = {}

    for _, model in ipairs(getNPCModels()) do
        seen[model] = true

        local data = createNPCESP(model)
        local distance = getDistance(model)
        local box = projectBodyBoundingBox(model)

        if distance <= State.RenderDistance and box then
            data.Root.Visible = true
            data.Root.Position = UDim2.fromOffset(box.x, box.y)
            data.Root.Size = UDim2.fromOffset(box.width, box.height)

            data.Box.Visible = State.Box
            data.Info.Visible = State.ShowName or State.ShowDistance
            data.Info.Position = UDim2.new(0.5, 0, 0, -4)
            data.Info.Size = UDim2.fromOffset(
                math.max(120, box.width + 100),
                18
            )

            local parts = {}

            if State.ShowName then
                table.insert(parts, model.Name)
            end

            if State.ShowDistance then
                table.insert(
                    parts,
                    string.format(
                        "%dm",
                        round(distance)
                    )
                )
            end

            data.Info.Text = table.concat(parts, " | ")
        else
            data.Root.Visible = false
            data.Box.Visible = false
            data.Info.Visible = false
        end
    end

    for model in pairs(NPCESP) do
        if not seen[model] or not model.Parent then
            removeNPCESP(model)
        end
    end
end

-- ================================================================
-- LOCAL HITBOX VISUALIZER
-- ================================================================

local function removeHitboxVisualizer(player)
    local object = HitboxVisuals[player]

    if object then
        object:Destroy()
        HitboxVisuals[player] = nil
    end
end

local function updateHitboxVisualizers()
    if not State.HitboxVisualizer then
        for player in pairs(HitboxVisuals) do
            removeHitboxVisualizer(player)
        end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = getCharacter(player)
            local part = character and getPart(
                character,
                State.HitboxPart
            )

            if character
                and part
                and isAlive(character)
                and withinRenderDistance(character) then

                local box = HitboxVisuals[player]

                if not box then
                    box = Instance.new("BoxHandleAdornment")
                    box.Name = "OverSeekHitboxVisualizer"
                    box.AlwaysOnTop = true
                    box.ZIndex = 5
                    box.Transparency = 0.65
                    box.Color3 = Color3.fromRGB(0, 150, 255)
                    box.Parent = Overlay
                    HitboxVisuals[player] = box
                end

                box.Adornee = part
                box.Size = Vector3.new(
                    State.HitboxX,
                    State.HitboxY,
                    State.HitboxZ
                )
            else
                removeHitboxVisualizer(player)
            end
        end
    end
end

-- ================================================================
-- AIMBOT - LOCAL CAMERA ONLY
-- ================================================================

local function updateAimbot(deltaTime)
    if State.AimMode ~= "Aimbot" then
        return
    end

    if not State.AimEnabled then
        return
    end

    local camera = getCamera()

    if not camera then
        return
    end

    local target = getClosestTarget()

    if not target or not target.position then
        return
    end

    local origin = camera.CFrame.Position
    local targetCFrame = CFrame.lookAt(
        origin,
        target.position
    )

    local smooth = math.max(
        State.AimSmooth,
        0.1
    )

    local alpha = 1 - math.exp(
        -smooth * deltaTime
    )

    alpha = clamp(alpha, 0.01, 0.95)

    camera.CFrame = camera.CFrame:Lerp(
        targetCFrame,
        alpha
    )
end

