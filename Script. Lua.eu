local QuickButtons = {}

local function setQuickState(button, enabled)
    if not button then
        return
    end

    button.BackgroundColor3 = enabled
        and Color3.fromRGB(0, 88, 160)
        or Color3.fromRGB(28, 30, 36)
end

local function createQuickButton(label, callback)
    local button = Instance.new("TextButton")
    button.Name = "Quick_" .. label
    button.Size = UDim2.fromOffset(50, 42)
    button.BackgroundColor3 = Color3.fromRGB(28, 30, 36)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Text = label
    button.AutoButtonColor = true
    button.Parent = QuickBar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = button

    button.Activated:Connect(callback)

    return button
end

